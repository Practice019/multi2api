# Auth & secrets
auths/
data/
*.key
*.pem

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
/bin/
*.tmp
__pycache__/

# 编译产物：实测根目录的 server.exe（12.5 MB）曾被提交进版本库
#（commit b9f8763），导致 .git 体积几乎全部来自这一个文件。
# 用 "/server.exe" 锚定根目录，避免误伤与目录同名的源文件；
# "*.exe" 是兜底 —— 二进制不该进版本库。
/server.exe
*.exe

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 运行期产物
# logs/ 是 start.bat 与网关控制台写出的日志（含本机绝对路径、账号昵称、
# 启动时间等），tasks/ 是本地计划与过程快照 —— 两者都不该进版本库。
# 注意：这两条必须写在这里，否则 `git add -A` 会把它们一起提交
# （实测：本仓库确实漏了这两条，曾出现 add 'logs/server-console.err.log'）。
logs/
tasks/
# .task/ 是多 agent 团队的工作区（规格/交接/评审/决策）。
# 它和 tasks/ 同类：过程产物，不是交付物，不入库。
# 实测：本轮起用 agent 团队后才发现这条漏了 —— 加它之前
# `git add -A` 会把整个团队工作区吞进提交。
.task/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
!SECURITY.md
!CHANGELOG.md

# 编辑器/工具留下的备份与「写错目标名」的编译产物。
# 实测出现过 wb2api-server.exe~（13 MB）：某次 go build -o 的目标名
# 多打了一个 ~，于是编译器把它当成一个**新文件**建出来，
# 而 *.exe 的通配**匹配不到**它（末尾是 ~ 不是 e）。
# 二进制不该进版本库，这里兜住这一类。
*~

# 生成器产物只应出现在 tests/frontend/。
# 实测：在根目录直接跑 
ode tests/frontend/gen_xxx.js 时，
# 有些生成器按**相对路径**写产物，于是根目录多出一份同名副本 ——
# 而它是**未跟踪**的，很容易被 git add . 顺手带进版本库。
# 锚定根目录，不影响 tests/frontend/ 下的正品。
/*_gen.js